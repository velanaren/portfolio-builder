# Portfolio Builder - Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# REQUIRED: Groq API Configuration
# ============================================

# Get your Groq API key from: https://console.groq.com/keys
# This key is used for:
# - Resume parsing (extracting data from uploaded resumes)
# - AI content enhancement (rewriting resume sections)
NEXT_PUBLIC_GROQ_API_KEY=your_groq_api_key_here

# Server-side Groq API key (for content rewriting)
# Usually the same as NEXT_PUBLIC_GROQ_API_KEY
GROQ_API_KEY=your_groq_api_key_here

# ============================================
# OPTIONAL: Groq Model Configuration
# ============================================

# Override the default Groq model
# Default: llama-3.1-8b-instant (fast, stable, recommended)
#
# Available models:
# - llama-3.1-8b-instant     (fast, 8B parameters, good quality - DEFAULT)
# - llama-3.1-70b-versatile  (slower, 70B parameters, better quality)
# - gemma-7b-it              (alternative, instruction-tuned)
#
# Check https://console.groq.com/docs/models for latest available models
#
# Uncomment to override:
# GROQ_MODEL=llama-3.1-70b-versatile

# Resume parsing model (used in /api/parse-resume)
# Uncomment to override:
# NEXT_PUBLIC_GROQ_MODEL=llama-3.1-8b-instant

# ============================================
# TROUBLESHOOTING
# ============================================

# If you get "model_decommissioned" errors:
# 1. Visit https://console.groq.com/docs/models
# 2. Find a currently available model
# 3. Update GROQ_MODEL and NEXT_PUBLIC_GROQ_MODEL above
# 4. Restart your dev server: npm run dev

# If resume parsing returns mock data:
# - Verify NEXT_PUBLIC_GROQ_API_KEY is set correctly
# - Restart dev server after adding/changing API key
# - Check server logs for [GROQ] messages

# ============================================
# NOTES
# ============================================

# .env.local vs .env.example:
# - .env.example: Template file (committed to git)
# - .env.local: Your actual values (never commit this!)
#
# To use:
# 1. Copy this file: cp .env.example .env.local
# 2. Replace "your_groq_api_key_here" with your actual key
# 3. Restart dev server: npm run dev
